  },
  "files": ["src/", "docs/", "README.md", "README.en.md", "CONTRIBUTING.md", "CODE_OF_CONDUCT.md", "SECURITY.md", "LICENSE"],
  "keywords": ["git", "github", "cli", "english", "turkish", "beginner", "education"],
  "license": "MIT"
}
