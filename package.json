{
  "name": "githelp",
  "version": "0.2.0",
  "description": "Understand Git and GitHub with a guided terminal in English and Turkish.",
  "type": "module",
  "bin": { "githelp": "src/cli.mjs" },
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
